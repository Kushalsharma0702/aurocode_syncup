[Unit]
Description=Syncup FastAPI Backend
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/apps/syncup/backend
EnvironmentFile=/opt/apps/syncup/backend/.env
ExecStartPre=/opt/apps/syncup/backend/.venv/bin/alembic upgrade head
ExecStart=/opt/apps/syncup/backend/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8002 \
    --workers 2 \
    --no-access-log
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=syncup-backend

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
