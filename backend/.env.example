# Copy to .env and adjust for your environment.

# "dev" relaxes startup safety checks. Set to "production" on a real server —
# the app then refuses to boot with a default SECRET_KEY, and seed.py refuses
# to create the demo accounts.
ENV=dev

# SQLite (development, default)
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (production, once you outgrow one studio)
# DATABASE_URL=postgresql://proposals:proposals@db:5432/proposals

# REQUIRED in production. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# 8 hours. Sessions are individually revocable from the Profile page.
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Public-facing base URL. Used to build widget snippets, report links and
# magic links, so it must match how people actually reach the app.
FRONTEND_PUBLIC_URL=http://localhost:5173

# ---- Share links ----
REPORT_LINK_EXPIRE_DAYS=30
# Share links get forwarded. Leave off unless you want the budget on them.
REPORT_SHOW_BUDGET=false

# ---- Feedback widget ----
WIDGET_MAX_SCREENSHOT_MB=5
WIDGET_RATE_PER_HOUR=60
WIDGET_RATE_PER_IP_PER_HOUR=20

# ---- Login protection ----
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# ---- Client magic links ----
MAGIC_LINK_EXPIRE_DAYS=30

# ---- Email (optional) ----
# Without these, in-app notifications still work but nothing reaches anyone
# outside the app. Set them up before onboarding a real client.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Aurocode SyncUp
SMTP_STARTTLS=true

# ---- Error reporting (optional) ----
# pip install sentry-sdk, then paste your DSN here.
SENTRY_DSN=
